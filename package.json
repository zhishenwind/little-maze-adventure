{
  "name": "little-maze-adventure",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base=/little-maze-adventure/ --outDir=dist-pages",
    "preview": "vite preview --host 0.0.0.0",
    "preview:pages": "vite preview --host 0.0.0.0 --base=/little-maze-adventure/ --outDir=dist-pages",
    "test": "node --experimental-strip-types --test src/game/maze.test.ts",
    "test:e2e": "npm run build && npm run build:pages && playwright test",
    "spec": "node scripts/openspec.mjs",
    "spec:validate": "npm run spec -- validate --all --strict --no-interactive && npm run spec -- validate --archived --strict --no-interactive",
    "check": "npm run spec:validate && npm test && npm run build",
    "check:full": "npm run check && npm run build:pages && playwright test",
    "offline": "npm run build && vite preview --host 0.0.0.0 --port 4173 --strictPort"
  },
  "dependencies": {
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.16.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  }
}
